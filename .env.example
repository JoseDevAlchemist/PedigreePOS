# ---------------------------------------------------------------------------
# Pedigree POS — environment variables
#
# Copy this file to `.env.local` and fill it in. `.env*` is gitignored, so the
# real values are never committed. Only `NEXT_PUBLIC_*` variables reach the
# browser bundle.
#
# The POS shares the storefront's Supabase project. The two values below are the
# same ones in the storefront's `.env.local`.
# ---------------------------------------------------------------------------

# The shared project URL. Dashboard -> Project Settings -> Data API.
NEXT_PUBLIC_SUPABASE_URL=

# The anon ("publishable") key. Dashboard -> Project Settings -> API Keys.
#
# Safe in the browser *because of RLS*, and here the surface is deliberately
# tiny: this key may read `products` and `pos_users`, call `pos_record_sale` to
# record a sale, and call `pos_daily_totals` for a manager rollup. Nothing else.
# It cannot read a sale back, and it cannot touch the catalogue.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# M-Pesa / Lipa Na M-Pesa (STK Push) — server-side only
# ---------------------------------------------------------------------------
# The Consumer Key and Passkey come from the Daraja (Safaricom) developer portal
# and MUST stay server-side: they are secrets, so they must NOT carry a
# `NEXT_PUBLIC_` prefix and must never reach the browser bundle. Only the
# till-initiated STK push and the Safarici webhook live server-side, behind
# `/api/pos/mpesa/*`.
#
# `MPESA_ENV` selects the Daraja environment. Use `sandbox` while testing with
# the Safaricom demo shortcode (174379), and `production` with your live shortcode
# before handling real money.
MPESA_ENV=sandbox

MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your_passkey_here

# The business shortcode the till charges. Safaricom's demo shortcode is 174379.
MPESA_SHORTCODE=174379

# The URL Safarici calls once the customer approves (or declines) the prompt.
# For local development this must be a public tunnel URL (e.g. an ngrok URL) —
# Safarici cannot reach a localhost callback.
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/pos/mpesa/callback

# ---------------------------------------------------------------------------
# Receipt email (optional)
# ---------------------------------------------------------------------------
# A JSON webhook that delivers a receipt. Left unset, the till queues receipts
# and reports that delivery is not configured — it does not pretend to send.
#
# The value stays server-side (no NEXT_PUBLIC_ prefix), so whatever credential
# it carries never reaches a browser.
# POS_RECEIPT_EMAIL_WEBHOOK=
